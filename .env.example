# TurtleLab - Configuración de entorno (opcional)
# Copia este archivo a .env y ajusta los valores si es necesario.
# TurtleLab funciona sin este archivo: los valores por defecto son suficientes.
# Nunca comites el archivo .env a un repositorio público.

# Puerto del panel web (por defecto 8080)
# PANEL_PORT=8080

# Directorio de datos (por defecto data/weltrade)
# DATA_ROOT=data/weltrade

# Directorio de resultados (por defecto results)
# RESULTS_ROOT=results

# Ruta de MetaTrader 5 (solo para descarga de datos)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe